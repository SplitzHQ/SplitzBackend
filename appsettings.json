{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=app.db"
  },
  "Storage": {
    "Provider": "S3",
    "Endpoint": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Bucket": "splitz",
    "Region": "us-east-1"
  },
  "Email": {
    "Provider": "Resend",
    "Enabled": false,
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "SplitZ",
    "FrontendBaseUrl": "http://localhost:5173",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password"
  },
  "RateLimiting": {
    "Enabled": true,
    "DefaultRetryAfterSeconds": 60,
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "Login": {
      "Ip": {
        "PermitLimit": 20,
        "WindowSeconds": 300,
        "SegmentsPerWindow": 5,
        "QueueLimit": 0
      },
      "Account": {
        "PermitLimit": 10,
        "WindowSeconds": 300,
        "SegmentsPerWindow": 5,
        "QueueLimit": 0
      }
    },
    "Registration": {
      "Ip": {
        "PermitLimit": 10,
        "WindowSeconds": 3600,
        "SegmentsPerWindow": 12,
        "QueueLimit": 0
      },
      "Account": {
        "PermitLimit": 6,
        "WindowSeconds": 3600,
        "SegmentsPerWindow": 12,
        "QueueLimit": 0
      }
    },
    "EmailDelivery": {
      "Ip": {
        "PermitLimit": 10,
        "WindowSeconds": 3600,
        "SegmentsPerWindow": 12,
        "QueueLimit": 0
      },
      "Account": {
        "PermitLimit": 6,
        "WindowSeconds": 3600,
        "SegmentsPerWindow": 12,
        "QueueLimit": 0
      }
    },
    "EmailConfirmation": {
      "Ip": {
        "PermitLimit": 20,
        "WindowSeconds": 900,
        "SegmentsPerWindow": 15,
        "QueueLimit": 0
      },
      "Account": {
        "PermitLimit": 10,
        "WindowSeconds": 900,
        "SegmentsPerWindow": 15,
        "QueueLimit": 0
      }
    },
    "PasswordReset": {
      "Ip": {
        "PermitLimit": 20,
        "WindowSeconds": 900,
        "SegmentsPerWindow": 15,
        "QueueLimit": 0
      },
      "Account": {
        "PermitLimit": 10,
        "WindowSeconds": 900,
        "SegmentsPerWindow": 15,
        "QueueLimit": 0
      }
    },
    "Upload": {
      "HourlyPerUser": {
        "PermitLimit": 200,
        "WindowSeconds": 3600,
        "SegmentsPerWindow": 12,
        "QueueLimit": 0
      },
      "GlobalConcurrencyPermitLimit": 5,
      "ConcurrencyRetryAfterSeconds": 5
    }
  }
}
